# Private local deployment configuration. Do not commit this file.
COMPOSE_PROJECT_NAME=open-webui-local
OPEN_WEBUI_PORT=3000
OPEN_WEBUI_IMAGE_TAG=local

# DaoCloud mirror for build images; use complete image names without https://.
OPEN_WEBUI_NODE_IMAGE=m.daocloud.io/docker.io/library/node:22-alpine3.20
OPEN_WEBUI_PYTHON_IMAGE=m.daocloud.io/docker.io/library/python:3.11-slim-bookworm

DEPLOYMENT_ENV=local
ENV=dev
DEPLOYMENT_ID=open-webui-local
WEBUI_SECRET_KEY=71182e447ae7f4de0fec21c5d6c57620c99697488a46d9c9fba01342e769b663
CORS_ALLOW_ORIGIN='http://localhost:5173;http://localhost:3000'

# PostgreSQL and pgvector share an environment-specific schema.
DATABASE_URL='postgresql://litellm:litellm@172.22.11.122:5432/openwebui?sslmode=disable'
DATABASE_SCHEMA=public
DATABASE_POOL_SIZE=5
DATABASE_POOL_MAX_OVERFLOW=5
DATABASE_POOL_TIMEOUT=30
DATABASE_POOL_RECYCLE=3600

# Redis direct master connection (Sentinel is currently disabled).
REDIS_URL='redis://default:auth-ha-data-test-only@172.22.11.122:6379/0'
REDIS_KEY_PREFIX=maas:auth:spec005-local
REDIS_CLUSTER=false
REDIS_SOCKET_CONNECT_TIMEOUT=5
REDIS_SOCKET_TIMEOUT=10
REDIS_HEALTH_CHECK_INTERVAL=30

# S3-compatible OSS.
STORAGE_PROVIDER=s3
STORAGE_LOCAL_CACHE=true
S3_ENDPOINT_URL='http://172.22.11.52:9000'
S3_REGION_NAME=us-east-1
S3_BUCKET_NAME=chatbot
S3_KEY_PREFIX=open-webui/local/
S3_ACCESS_KEY_ID=a9ogBo0qaaYEiGzu
S3_SECRET_ACCESS_KEY=bRvbRpAaAbwRmC1OW8rmaZoFIgtCRRuh
S3_ADDRESSING_STYLE=auto
S3_ENABLE_TAGGING=false

# pgvector.
VECTOR_DB=pgvector
PGVECTOR_DB_URL='postgresql://litellm:litellm@172.22.11.122:5432/openwebui?sslmode=disable'
PGVECTOR_CREATE_EXTENSION=true
PGVECTOR_INDEX_METHOD=hnsw
PGVECTOR_INITIALIZE_MAX_VECTOR_LENGTH=1536

# Use the model cache baked into the source-built image/volume; avoid startup snapshot sync.
RAG_EMBEDDING_MODEL=/app/backend/data/cache/embedding/local/all-MiniLM-L6-v2
RAG_EMBEDDING_MODEL_AUTO_UPDATE=false
RAG_RERANKING_MODEL_AUTO_UPDATE=false
WHISPER_MODEL_AUTO_UPDATE=false
