# Open WebUI - production environment
# Real credentials belong in .env (chmod 600); it may be committed with authorization.
# See README.md in this directory before deployment.

COMPOSE_PROJECT_NAME=open-webui-prod
OPEN_WEBUI_PORT=3000
OPEN_WEBUI_IMAGE_TAG=prod

# DaoCloud mirror for build images; use complete image names without https://.
OPEN_WEBUI_NODE_IMAGE=m.daocloud.io/docker.io/library/node:22-alpine3.20
OPEN_WEBUI_PYTHON_IMAGE=m.daocloud.io/docker.io/library/python:3.11-slim-bookworm
OPEN_WEBUI_SUBNET=192.168.30.0/24

DEPLOYMENT_ENV=prod
ENV=prod
DEPLOYMENT_ID=open-webui-prod
WEBUI_SECRET_KEY=cWfBtArmRuBtwcS2JOmt6kSWSIlWed5kl6vNiaXNn8QgOH3pccyYM6kWy7PVdaIP
CORS_ALLOW_ORIGIN='https://chatbot.maxphotonics.com'
WEBUI_SESSION_COOKIE_SECURE=true
WEBUI_AUTH_COOKIE_SECURE=true
UVICORN_WORKERS=1

# PostgreSQL: dedicated business database; URL-encode reserved password characters.
# sslmode=prefer until the database TLS configuration has been confirmed.
DATABASE_URL='postgresql://postgres:%2FPH0hTxt0M2dGxqI8lM1W8o0GaIfrohx2wg8KCbPQiHkYJAo@172.16.60.190:5000/openwebui?sslmode=prefer&connect_timeout=10'
DATABASE_SCHEMA=public
DATABASE_POOL_SIZE=20
DATABASE_POOL_MAX_OVERFLOW=20
DATABASE_POOL_TIMEOUT=30
DATABASE_POOL_RECYCLE=1800

# Redis Sentinel: REDIS_URL host is the monitored master name, NOT a node IP.
# Replace the name with the result of SENTINEL MASTERS (case-sensitive).
REDIS_SENTINEL_MASTER_NAME=aigwmaster
REDIS_PASSWORD=BXvkBQAkw6p0AeSZKD6QwML6c2vjHUSv
SENTINEL_PASSWORD=KhXMgyNeNA3sJ0aSj17f7Mr7h5NimY4R
REDIS_URL=redis://:${REDIS_PASSWORD}@${REDIS_SENTINEL_MASTER_NAME}:6379/0
REDIS_SENTINEL_HOSTS=172.16.60.185,172.16.60.186,172.16.60.187
REDIS_SENTINEL_PORT=26379
REDIS_SENTINEL_PASSWORD=${SENTINEL_PASSWORD}
REDIS_KEY_PREFIX=open-webui:prod
REDIS_CLUSTER=false
REDIS_SENTINEL_MAX_RETRY_COUNT=5
REDIS_RECONNECT_DELAY=500
REDIS_SOCKET_CONNECT_TIMEOUT=5
REDIS_SOCKET_TIMEOUT=10
REDIS_SOCKET_KEEPALIVE=true
REDIS_HEALTH_CHECK_INTERVAL=30

# Socket.IO uses a separate client; it must also discover the master via Sentinel.
WEBSOCKET_MANAGER=redis
WEBSOCKET_REDIS_URL=${REDIS_URL}
WEBSOCKET_REDIS_CLUSTER=false
WEBSOCKET_SENTINEL_HOSTS=${REDIS_SENTINEL_HOSTS}
WEBSOCKET_SENTINEL_PORT=${REDIS_SENTINEL_PORT}

# Company OSS: S3-compatible API, Signature V4 (boto3 default), automatic addressing.
STORAGE_PROVIDER=s3
STORAGE_LOCAL_CACHE=true
S3_ENDPOINT_URL='https://fs.maxphotonics.com:9443'
# Confirm the signing region with the OSS administrator if us-east-1 is rejected.
S3_REGION_NAME=us-east-1
S3_BUCKET_NAME=chatbot
S3_KEY_PREFIX=open-webui/prod/
S3_ACCESS_KEY_ID=rebateprod
S3_SECRET_ACCESS_KEY=BAsWdlsEeEea3pmomSB9WXvxkp6e3nDF
S3_ADDRESSING_STYLE=auto
S3_ENABLE_TAGGING=false

# pgvector shares the dedicated production PostgreSQL database.
# DBA must install the server extension and CREATE EXTENSION vector before startup.
VECTOR_DB=pgvector
PGVECTOR_DB_URL=${DATABASE_URL}
PGVECTOR_CREATE_EXTENSION=false
PGVECTOR_INDEX_METHOD=hnsw
# The bundled all-MiniLM-L6-v2 embedding model outputs 384 dimensions.
PGVECTOR_INITIALIZE_MAX_VECTOR_LENGTH=384
PGVECTOR_POOL_SIZE=5
PGVECTOR_POOL_MAX_OVERFLOW=5
PGVECTOR_POOL_TIMEOUT=30
PGVECTOR_POOL_RECYCLE=1800

# Build/cache models before deployment; do not download them during startup.
RAG_EMBEDDING_MODEL=/app/backend/data/cache/embedding/local/all-MiniLM-L6-v2
RAG_EMBEDDING_MODEL_AUTO_UPDATE=false
RAG_RERANKING_MODEL_AUTO_UPDATE=false
WHISPER_MODEL_AUTO_UPDATE=false
