# Open WebUI - test environment
# Copy this file to .env in the same directory and replace every CHANGE_ME value.

# Docker Compose deployment selection
COMPOSE_PROJECT_NAME=open-webui-test
OPEN_WEBUI_PORT=3000
OPEN_WEBUI_IMAGE_TAG=test

# DaoCloud mirror for build images; use complete image names without https://.
OPEN_WEBUI_NODE_IMAGE=m.daocloud.io/docker.io/library/node:22-alpine3.20
OPEN_WEBUI_PYTHON_IMAGE=m.daocloud.io/docker.io/library/python:3.11-slim-bookworm
OPEN_WEBUI_SUBNET=192.168.30.0/24

DEPLOYMENT_ENV=test
ENV=test
DEPLOYMENT_ID=open-webui-test
WEBUI_SECRET_KEY=CHANGE_ME_TEST_RANDOM_SECRET_AT_LEAST_32_CHARS
CORS_ALLOW_ORIGIN='https://chat-test.company.example'
WEBUI_SESSION_COOKIE_SECURE=true
WEBUI_AUTH_COOKIE_SECURE=true

# PostgreSQL
# Test uses a separate database rather than a schema inside the litellm database.
DATABASE_URL='postgresql://litellm:CHANGE_ME_POSTGRES_PASSWORD@172.22.11.122:5432/openwebui_test?sslmode=disable'
DATABASE_SCHEMA=public
DATABASE_POOL_SIZE=10
DATABASE_POOL_MAX_OVERFLOW=10
DATABASE_POOL_TIMEOUT=30
DATABASE_POOL_RECYCLE=1800

# Redis direct master connection (Sentinel is currently disabled).
REDIS_URL='redis://default:CHANGE_ME_REDIS_DATA_PASSWORD@172.22.11.122:6379/0'
REDIS_KEY_PREFIX=maas:auth:spec005-test
REDIS_CLUSTER=false
REDIS_SOCKET_CONNECT_TIMEOUT=5
REDIS_SOCKET_TIMEOUT=10
REDIS_SOCKET_KEEPALIVE=true
REDIS_HEALTH_CHECK_INTERVAL=30

# Company OSS (S3-compatible API)
STORAGE_PROVIDER=s3
STORAGE_LOCAL_CACHE=true
S3_ENDPOINT_URL='http://172.22.11.52:9000'
S3_REGION_NAME=us-east-1
S3_BUCKET_NAME=chatbot
S3_KEY_PREFIX=open-webui/test/
S3_ACCESS_KEY_ID=CHANGE_ME_OSS_ACCESS_KEY
S3_SECRET_ACCESS_KEY=CHANGE_ME_OSS_SECRET_KEY
S3_ADDRESSING_STYLE=auto
S3_ENABLE_TAGGING=false

# Vector database: pgvector (stored in the dedicated openwebui_test database)
VECTOR_DB=pgvector
PGVECTOR_DB_URL='postgresql://litellm:CHANGE_ME_POSTGRES_PASSWORD@172.22.11.122:5432/openwebui_test?sslmode=disable'
PGVECTOR_CREATE_EXTENSION=true
PGVECTOR_INDEX_METHOD=hnsw
PGVECTOR_INITIALIZE_MAX_VECTOR_LENGTH=1536

# Use the model cache baked into the source-built image/volume; avoid startup snapshot sync.
RAG_EMBEDDING_MODEL=/app/backend/data/cache/embedding/local/all-MiniLM-L6-v2
RAG_EMBEDDING_MODEL_AUTO_UPDATE=false
RAG_RERANKING_MODEL_AUTO_UPDATE=false
WHISPER_MODEL_AUTO_UPDATE=false

# Alternative: Milvus. Comment the pgvector block and uncomment these lines.
# VECTOR_DB=milvus
# MILVUS_URI='https://milvus.test.company.internal:19530'
# MILVUS_DB=openwebui_test
# MILVUS_TOKEN=CHANGE_ME_TEST_MILVUS_TOKEN
# MILVUS_COLLECTION_PREFIX=openwebui_test
